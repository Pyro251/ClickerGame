; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Clicker Game (Talo)"
run/main_scene="uid://ba0lxtqgdci41"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.98039216, 0.9098039, 0.8784314, 1)
boot_splash/image="uid://crrkd5nnf4uik"

[autoload]

Global="*uid://bd86qs7xa7v5u"
Talo="*uid://bpmdn8oc34pg7"
GuiTransitions="*uid://lbwvyqfdnu7x"
EBSAutoHide="*uid://b1gen7vlnx0bi"

[debug]

gdscript/warnings/inference_on_variant=1
gdscript/warnings/native_method_override=1
gdscript/warnings/get_node_default_without_onready=1
gdscript/warnings/onready_with_export=1

[display]

window/size/viewport_width=720
window/size/viewport_height=1540
window/size/window_width_override=528
window/size/window_height_override=1078
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[editor_plugins]

enabled=PackedStringArray("res://addons/easy_bootsplash/plugin.cfg", "res://addons/simple-gui-transitions/plugin.cfg", "res://addons/talo/plugin.cfg")

[gui_transitions]

config/default/auto_start=true
config/default/fade_layout=true
config/default/center_pivot=true
config/default/duration=0.5
config/default/delay=0.5
config/default/transition_type="QUAD"
config/default/ease_type="IN_OUT"
config/default/animation_enter=4
config/default/animation_leave=4

[input_devices]

pointing/emulate_touch_from_mouse=true
virtual_controller/ios/enable_controller=false
virtual_controller/ios/enable_left_thumbstick=true
virtual_controller/ios/enable_right_thumbstick=true
virtual_controller/ios/enable_button_a=true
virtual_controller/ios/enable_button_b=true
virtual_controller/ios/enable_button_x=true
virtual_controller/ios/enable_button_y=true

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
